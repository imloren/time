{
  "name": "time-record",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "biome check . && tsc --noEmit && rsbuild build",
    "dev": "rsbuild dev --open",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "preview": "rsbuild preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@rsbuild/core": "^2.2.13",
    "@rsbuild/plugin-less": "^2.0.1",
    "@rsbuild/plugin-react": "^2.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
